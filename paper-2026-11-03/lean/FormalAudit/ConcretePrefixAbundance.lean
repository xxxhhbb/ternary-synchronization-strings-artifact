import Mathlib
import FormalAudit.ConcreteAbundance

namespace TernarySyncAudit

open Finset

/-- Number of 18-letter macroblocks needed to cover a length-`n` prefix. -/
def macroblockCount (n : ℕ) : ℕ := (n + 17) / 18

theorem prefix_fits_macroblocks (n : ℕ) :
    n ≤ 18 * macroblockCount n := by
  have remainder : (n + 17) % 18 < 18 := Nat.mod_lt _ (by norm_num)
  have decomposition :
      (n + 17) % 18 + 18 * ((n + 17) / 18) = n + 17 :=
    Nat.mod_add_div _ _
  dsimp [macroblockCount]
  omega

theorem previous_macroblocks_end_before_prefix
    {n : ℕ} (nPositive : 0 < n) :
    18 * (macroblockCount n - 1) < n := by
  have remainder : (n + 17) % 18 < 18 := Nat.mod_lt _ (by norm_num)
  have decomposition :
      (n + 17) % 18 + 18 * ((n + 17) / 18) = n + 17 :=
    Nat.mod_add_div _ _
  have countPositive : 0 < macroblockCount n := by
    dsimp [macroblockCount]
    omega
  dsimp [macroblockCount] at countPositive ⊢
  omega

/-- The actual length-`n` prefix generated by a finite occurrence-choice vector. -/
def finiteEncodedPrefix
    {N n : ℕ} (outer : ℕ → Symbol) (branch : Fin N → Choice) :
    FixedWord Symbol n := fun position =>
  codeStream outer (extendFiniteChoices branch) position.val

/-- If the prefix covers all but possibly the last macroblock, then fixing the
last choice makes the prefix map injective. -/
theorem finiteEncodedPrefix_injective_given_last
    {N n : ℕ} (outer : ℕ → Symbol)
    (NPositive : 0 < N) (previousEnd : 18 * (N - 1) < n)
    (left right : Fin N → Choice)
    (prefixEqual :
      finiteEncodedPrefix (N := N) (n := n) outer left =
        finiteEncodedPrefix (N := N) (n := n) outer right)
    (lastEqual : left ⟨N - 1, by omega⟩ = right ⟨N - 1, by omega⟩) :
    left = right := by
  funext block
  by_cases lastBlock : block.val = N - 1
  · have blockEq : block = ⟨N - 1, by omega⟩ := Fin.ext lastBlock
    simpa [blockEq] using lastEqual
  · have blockBefore : block.val < N - 1 := by omega
    have signaturesEqual :
        ∀ position : Fin 7,
          symbolAt (codeword (outer block.val) (left block)) position.val =
            symbolAt (codeword (outer block.val) (right block)) position.val := by
      intro position
      have characterLt : 18 * block.val + position.val < n := by
        omega
      let prefixPosition : Fin n := ⟨18 * block.val + position.val, characterLt⟩
      have atPosition := congrFun prefixEqual prefixPosition
      change
        codeStream outer (extendFiniteChoices left)
            (18 * block.val + position.val) =
          codeStream outer (extendFiniteChoices right)
            (18 * block.val + position.val) at atPosition
      rw [codeStream_aligned outer (extendFiniteChoices left)
          block.val position.val (by omega),
        codeStream_aligned outer (extendFiniteChoices right)
          block.val position.val (by omega)] at atPosition
      rw [extendFiniteChoices_at left block.isLt,
        extendFiniteChoices_at right block.isLt] at atPosition
      exact atPosition
    exact (prefix_signature_injective
      (outer block.val) (outer block.val) (left block) (right block)
      signaturesEqual).2

/-- Every generated prefix has at most two occurrence-choice preimages. -/
theorem finiteEncodedPrefix_fiber_card_le_two
    {N n : ℕ} (outer : ℕ → Symbol)
    (NPositive : 0 < N) (previousEnd : 18 * (N - 1) < n)
    (choices : Finset (Fin N → Choice)) (targetPrefix : FixedWord Symbol n) :
    (choices.filter fun branch =>
      finiteEncodedPrefix (N := N) (n := n) outer branch = targetPrefix).card ≤ 2 := by
  classical
  let fiber := choices.filter fun branch =>
    finiteEncodedPrefix (N := N) (n := n) outer branch = targetPrefix
  let lastIndex : Fin N := ⟨N - 1, by omega⟩
  let lastChoice : ↑fiber → Choice := fun branch => branch.val lastIndex
  have lastChoiceInjective : Function.Injective lastChoice := by
    intro left right equalLast
    apply Subtype.ext
    apply finiteEncodedPrefix_injective_given_last outer NPositive previousEnd
    · have leftPrefix := (Finset.mem_filter.mp left.property).2
      have rightPrefix := (Finset.mem_filter.mp right.property).2
      exact leftPrefix.trans rightPrefix.symm
    · simpa [lastChoice, lastIndex] using equalLast
  calc
    (choices.filter fun branch =>
        finiteEncodedPrefix (N := N) (n := n) outer branch = targetPrefix).card =
        Fintype.card ↑fiber := by
      rw [Fintype.card_coe]
    _ ≤ Fintype.card Choice :=
      Fintype.card_le_of_injective lastChoice lastChoiceInjective
    _ = 2 := by simp

/-- The paper's explicit `exp(n/28)` abundance theorem for generated ternary
prefixes, now connected to the concrete LLL event family. -/
theorem concrete_prefix_abundance
    {n : ℕ} (hn : 756 ≤ n) (outer : ℕ → Symbol) :
    Real.exp ((n : ℝ) / 28) ≤
      ((avoidOutcomes
          (longIntervalEvent (macroblockCount n) outer)
          (Finset.univ : Finset (LongIntervalIndex (macroblockCount n)))).image
        (finiteEncodedPrefix (N := macroblockCount n) (n := n) outer)).card := by
  let N := macroblockCount n
  let M := 18 * N
  let good := avoidOutcomes (longIntervalEvent N outer)
    (Finset.univ : Finset (LongIntervalIndex N))
  let truncate := finiteEncodedPrefix (N := N) (n := n) outer
  have nPositive : 0 < n := by omega
  have NPositive : 0 < N := by
    have fits := prefix_fits_macroblocks n
    dsimp [N] at fits ⊢
    omega
  have previousEnd : 18 * (N - 1) < n := by
    exact previous_macroblocks_end_before_prefix nPositive
  have nLeM : n ≤ M := by
    exact prefix_fits_macroblocks n
  have choiceLower :
      Real.exp ((Real.log 2 / 18 - 202 * Real.exp (-20)) * M) ≤
        good.card := by
    simpa [M, good] using concrete_good_choice_abundance N outer
  have rateLower :
      (M : ℝ) / 27 ≤
        (Real.log 2 / 18 - 202 * Real.exp (-20)) * M := by
    have rate := explicit_full_output_exponent
    have Mnonnegative : (0 : ℝ) ≤ M := by positivity
    nlinarith
  have fullLower : Real.exp ((M : ℝ) / 27) ≤ good.card :=
    (Real.exp_monotone rateLower).trans choiceLower
  apply explicit_prefix_abundance good truncate hn nLeM fullLower
  intro targetPrefix prefixIn
  exact finiteEncodedPrefix_fiber_card_le_two outer NPositive previousEnd good targetPrefix

end TernarySyncAudit
